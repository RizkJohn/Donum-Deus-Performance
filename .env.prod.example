# Deus Performance — production environment variables
# Copy to .env.prod (git-ignored) and fill in real values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Postgres ---
POSTGRES_USER=deus
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=deus

# --- API ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Comma-separated list of allowed CORS origins (your production web domain).
CORS_ORIGINS=https://deusperformance.com

# Auth
SECRET_KEY=replace_with_64_char_random_string
WEB_URL=https://deusperformance.com

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ENGINE=price_...
STRIPE_PRICE_HYBRID=price_...
STRIPE_PRICE_PREMIUM=price_...

# --- Web ---
# Public-facing URL of the API — must be reachable from the browser.
NEXT_PUBLIC_API_URL=https://api.deusperformance.com
