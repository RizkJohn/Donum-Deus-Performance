# Donum Dei Performance — PRODUCTION environment (VPS backend stack)
# Copy to `.env` on the server:  cp .env.prod.example .env
# then fill every value below. NEVER commit the real .env (it is gitignored).
#
# Used by: docker-compose.prod.yml  (postgres · api · n8n · caddy)
# The website deploys separately to Netlify from apps/web (see netlify.toml).

# ─── Domains ──────────────────────────────────────────────────────────────
# api + n8n are A records pointing at THIS server. WEB_DOMAIN (the apex) is
# served by Netlify — it's set here only so the API allows it via CORS.
WEB_DOMAIN=donumdeiperformance.com
API_DOMAIN=api.donumdeiperformance.com
N8N_DOMAIN=n8n.donumdeiperformance.com
TZ=America/New_York

# ─── Database ─────────────────────────────────────────────────────────────
# Strong random password. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── API secrets ──────────────────────────────────────────────────────────
# Sign-in tokens. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_DAYS=30

# Real program generation. Set to `mock` to launch the site without an
# Anthropic bill (programs are then deterministic placeholders).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend) ───────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
DDP_EMAIL_FROM=Donum Dei Performance <programs@donumdeiperformance.com>
DDP_OWNER_EMAIL=johnrizkalla2300@gmail.com

# ─── Stripe (subscription billing) ────────────────────────────────────────
# Leave blank to launch without billing (checkout routes return a clear
# "not configured" message instead of crashing). Fill in when you go paid.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_FOUNDATION=price_...
STRIPE_PRICE_PRACTICE=price_...
STRIPE_PRICE_STEWARDSHIP=price_...

# ─── n8n ──────────────────────────────────────────────────────────────────
# Encrypts saved credentials. Generate ONCE and never change: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Model used by the Claude-drafting workflows (content, newsletter, Q&A).
DDP_CLAUDE_MODEL=claude-sonnet-5
