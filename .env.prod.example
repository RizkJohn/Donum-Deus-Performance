# Deus Performance — production environment variables
# Copy to .env.prod (git-ignored) and fill in real values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Postgres ---
POSTGRES_USER=deus
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=deus

# --- API ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Comma-separated list of allowed CORS origins (your production web domain).
CORS_ORIGINS=https://deusperformance.com

# --- Web ---
# Public-facing URL of the API — must be reachable from the browser.
NEXT_PUBLIC_API_URL=https://api.deusperformance.com
