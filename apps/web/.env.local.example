# URL of the FastAPI engine — used by server-side Next.js code only.
# In Docker the service name resolves: http://api:8000
# For local dev pointing at a local API: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match the API_KEY configured on the FastAPI service.
# Server-side only (not NEXT_PUBLIC_) — never sent to the browser.
INTERNAL_API_KEY=
