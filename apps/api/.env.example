# Deus Performance API — environment
# Default provider is `mock`: the full pipeline runs with NO API key.
LLM_PROVIDER=mock
# Switch to real generation:
#LLM_PROVIDER=claude
#ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Local default is sqlite; docker-compose overrides with postgres.
DATABASE_URL=sqlite+aiosqlite:///./deus.db
CORS_ORIGINS=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# API_KEY: when set, every request (except /healthz) must carry the header
#   X-API-Key: <value>
# Leave empty for local development. Set a strong random secret in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Set to true in production to suppress /docs and /redoc.
DISABLE_DOCS=false

# Maximum request body size in bytes (default 65536 = 64 KB).
MAX_REQUEST_BYTES=65536
