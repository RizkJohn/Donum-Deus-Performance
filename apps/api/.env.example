# Deus Performance API — environment
# Default provider is `mock`: the full pipeline runs with NO API key.
LLM_PROVIDER=mock
# Switch to real generation:
#LLM_PROVIDER=claude
#ANTHROPIC_API_KEY=sk-ant-...
# Tiered models — Opus reasons over the assessment, Sonnet generates sessions,
# Haiku powers the (deferred) chat coach. Only billed when LLM_PROVIDER=claude.
ASSESSMENT_MODEL=claude-opus-4-8
GENERATION_MODEL=claude-sonnet-4-6
CHAT_MODEL=claude-haiku-4-5-20251001

# Local default is sqlite; docker-compose overrides with postgres.
# Production (Neon, set in Railway's Variables tab): use the DIRECT
# (non--pooler) hostname, scheme postgresql+asyncpg://, and ?ssl=require —
# NOT ?sslmode=require, which asyncpg rejects. Example shape:
#DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./deus.db
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# Accounts — stateless JWT sessions. MUST override in any real deployment;
# the API refuses to start against Postgres while this default is in place.
AUTH_JWT_SECRET=dev-insecure-secret-change-me-before-any-real-deploy
AUTH_TOKEN_TTL_DAYS=30
# GDPR export/erasure confirmation codes (POST /v1/data/request) expire after:
DATA_TOKEN_TTL_MINUTES=30

# Stripe — subscription billing. Leave unset to run everything else without
# Stripe configured; billing routes return a clear error instead of a crash.
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_FOUNDATION=price_...
#STRIPE_PRICE_PRACTICE=price_...
#STRIPE_PRICE_STEWARDSHIP=price_...

# Email — default `mock` sends nothing (offline, no key needed).
EMAIL_PROVIDER=mock
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=re_...
EMAIL_FROM=Deus Performance <programs@deusperformance.com>
