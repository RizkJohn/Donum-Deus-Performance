# Deus Performance API — environment
# Default provider is `mock`: the full pipeline runs with NO API key.
LLM_PROVIDER=mock
# Switch to real generation:
#LLM_PROVIDER=claude
#ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Local default is sqlite; docker-compose overrides with postgres.
DATABASE_URL=sqlite+aiosqlite:///./deus.db
CORS_ORIGINS=http://localhost:3000

# Auth — change SECRET_KEY before deploying (any random string ≥ 32 chars).
SECRET_KEY=dev-secret-change-in-production
WEB_URL=http://localhost:3000

# Email (console = print to stdout; resend = real email via Resend API)
EMAIL_PROVIDER=console
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=re_...

# Stripe (leave blank to disable billing routes)
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_ENGINE=price_...
#STRIPE_PRICE_HYBRID=price_...
#STRIPE_PRICE_PREMIUM=price_...
