# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Notion internal integration token (starts with "secret_").
# Create one at https://www.notion.so/my-integrations, then share the
# content calendar database with it (open the database → ··· → Connections).
NOTION_API_KEY=ntn_W89942842385pTLXr3ZJlqR2FX97zHPH6vHZtZXhgbhdh1

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Notion database ID for the content calendar.
NOTION_DATABASE_ID=88bf899d-a0aa-4c8a-9d24-c243a87008f3

# Platforms to generate for (comma-separated, order matters for cycling).
PLATFORMS=Instagram,TikTok,Threads

# Content types to generate (comma-separated, cycles with platforms).
CONTENT_TYPES=Motivational,Educational

# Total posts generated per run. Cycles evenly across PLATFORMS × CONTENT_TYPES.
# Default 6 = 1 post per (3 platforms × 2 types).
POSTS_PER_RUN=6

# Cron expression (UTC) used in daemon mode: "minute hour day month day_of_week".
# Default: every day at 08:00 UTC.
SCHEDULE_CRON=0 8 * * *

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
