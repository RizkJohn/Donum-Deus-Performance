        "emailFormat": "html",
        "html": "=<!DOCTYPE html><html><body style=\"font-family:'Helvetica Neue',Arial,sans-serif;background:#0b0f0c;color:#d4ddd6;max-width:600px;margin:0 auto;padding:32px\"><h1 style=\"color:#7caf58\">Welcome, {{ $json.name }}.</h1><p>Your personalized training program has been generated. Every session is built around your movement capacity, recovery state, and goals — not a generic template.</p><a href=\"https://deusperformance.com/program/{{ $json.run_id }}\" style=\"display:inline-block;background:#7caf58;color:#0b0f0c;padding:12px 24px;border-radius:4px;text-decoration:none;font-weight:700;margin:16px 0\">View Your Program</a><p>Questions? Reply to this email.</p><p style=\"color:#6b7a6e;font-size:12px\">Deus Performance · Riz Management LLC<br><em>The body is a gift. Train it accordingly.</em></p></body></html>",
        "options": {}
