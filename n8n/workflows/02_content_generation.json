{
  "name": "02 – Content Generation (Daily Social Posts)",
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule – 8 AM Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      }
    },
    {
      "id": "build-configs",
      "name": "Build Content Configs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const platforms = ['Instagram', 'TikTok', 'Threads'];\nconst types = ['Motivational', 'Educational'];\nconst date = new Date().toISOString().split('T')[0];\nconst items = [];\nfor (const platform of platforms) {\n  for (const contentType of types) {\n    items.push({ json: { platform, contentType, date } });\n  }\n}\nreturn items;"
      }
    },
    {
      "id": "split",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "build-prompt",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const { platform, contentType, date } = $json;\n\nconst platformGuide = {\n  Instagram: 'short caption (≤220 chars) + 5 relevant hashtags. Use line breaks for readability.',\n  TikTok: 'punchy hook ≤150 chars + CTA. High-energy, concise.',\n  Threads: 'conversational, 1-3 short paragraphs, no hashtags.'\n}[platform] || '';\n\nconst prompt = `You are the content voice for Deus Performance — a constraint-driven adaptive training system by Riz Management LLC.\nBrand tone: precise, disciplined, no hype. Movement-based.\nTagline: Deus. The body is a gift. Train it accordingly.\n\nWrite ONE ${contentType.toLowerCase()} post for ${platform}.\nFormat: ${platformGuide}\nDate context: ${date}\n\nContent type guidance:\n- Motivational: rooted in training philosophy, discipline, long-term thinking. Avoid clichés.\n- Educational: a single actionable insight about movement, fatigue, recovery, or programming logic.\n\nReturn ONLY the post text. No preamble, no labels.`;\n\nreturn [{ json: { ...$json, prompt } }];"
      }
    },
    {
      "id": "call-claude",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type",       "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 512, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": { "timeout": 30000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "anthropic-api", "name": "Anthropic API" }
      }
    },
    {
      "id": "parse-response",
      "name": "Parse Post Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const resp = $json;\nconst postText = resp.content?.[0]?.text?.trim() || '';\nconst prev = $('Build Claude Prompt').item.json;\nreturn [{ json: { ...prev, postText, generatedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "save-notion",
      "name": "Notion – Save to Content Calendar",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [1560, 300],
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_CONTENT_DATABASE_ID }}",
          "mode": "id"
        },
        "title": "={{ $json.platform + ' · ' + $json.contentType + ' · ' + $json.date }}",
        "propertiesUi": {
          "propertyValues": [
            { "key": "Platform|select",    "selectValue": "={{ $json.platform }}" },
            { "key": "Type|select",        "selectValue": "={{ $json.contentType }}" },
            { "key": "Status|select",      "selectValue": "Draft" },
            { "key": "Date|date",          "dateValue": "={{ $json.date }}" },
            { "key": "Content|rich_text",  "textValue": "={{ $json.postText }}" }
          ]
        }
      },
      "credentials": {
        "notionApi": { "id": "notion-api", "name": "Notion" }
      }
    },
    {
      "id": "loop-back",
      "name": "Loop Back",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1780, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "slack-summary",
      "name": "Slack – Daily Content Summary",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [1780, 500],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": {
          "__rl": true,
          "value": "#deus-content",
          "mode": "name"
        },
        "text": ":pencil: *Daily content generation complete* — {{ new Date().toLocaleDateString() }}\n6 posts saved to Notion content calendar. Review & schedule at notion.so",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": { "id": "deus-slack", "name": "Deus Slack" }
      }
    }
  ],
  "connections": {
    "Schedule – 8 AM Daily": {
      "main": [[{ "node": "Build Content Configs", "type": "main", "index": 0 }]]
    },
    "Build Content Configs": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Split In Batches": {
      "main": [
        [{ "node": "Build Claude Prompt", "type": "main", "index": 0 }],
        [{ "node": "Slack – Daily Content Summary", "type": "main", "index": 0 }]
      ]
    },
    "Build Claude Prompt": {
      "main": [[{ "node": "Call Claude API", "type": "main", "index": 0 }]]
    },
    "Call Claude API": {
      "main": [[{ "node": "Parse Post Content", "type": "main", "index": 0 }]]
    },
    "Parse Post Content": {
      "main": [[{ "node": "Notion – Save to Content Calendar", "type": "main", "index": 0 }]]
    },
    "Notion – Save to Content Calendar": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 1 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "content" }, { "name": "marketing" }]
}
