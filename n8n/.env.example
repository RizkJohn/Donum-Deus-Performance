# ─── n8n Self-Hosted Configuration ───────────────────────────────────────────
# Copy to .env (root) and fill in real values. Never commit real secrets.

# Required — generate a random 32-char string for credential encryption
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# Required — used for signing user-management JWTs
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-to-another-random-string

# Public URL where n8n is reachable (used for webhook URLs shown in UI)
# Local dev:    http://localhost:5678
# Production:   https://n8n.deusperformance.com
N8N_WEBHOOK_URL=http://localhost:5678

# Timezone for cron schedules
TIMEZONE=America/New_York

# ─── Deus API → n8n integration ───────────────────────────────────────────────
# Set to the n8n base URL so the API fires webhooks after program generation.
# Leave empty to disable (assessment still works; n8n workflows just won't fire).
N8N_WEBHOOK_URL=http://n8n:5678

# ─── Credentials referenced by n8n workflows ──────────────────────────────────
# Configure these as credentials inside the n8n UI (Settings → Credentials).
# They are listed here only for reference.

# Anthropic (for content-generation workflow)
# Credential type: HTTP Header Auth  Name: Anthropic API
# Header name: x-api-key  Value: sk-ant-...
ANTHROPIC_API_KEY=

# Notion (for CRM + content calendar workflows)
# Credential type: Notion API  Name: Notion
NOTION_API_KEY=
NOTION_CRM_DATABASE_ID=          # Leads / athlete CRM database
NOTION_CONTENT_DATABASE_ID=      # Social content calendar database
NOTION_PRODUCTS_DATABASE_ID=     # E-commerce product pipeline database

# SMTP (for email delivery workflows)
# Credential type: SMTP  Name: Deus SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@deusperformance.com
SMTP_PASS=
SMTP_FROM=Deus Performance <hello@deusperformance.com>

# Slack (for team notifications)
# Credential type: Slack API  Name: Deus Slack
# Requires a Slack Bot OAuth token (xoxb-...)
SLACK_BOT_TOKEN=

# Shopify (for e-commerce pipeline workflow)
# Credential type: Shopify API  Name: Shopify
SHOPIFY_SHOP_URL=deusperformance.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Team notification recipients
TEAM_EMAIL=team@deusperformance.com
REPORTS_SLACK_CHANNEL=#deus-reports
