# Donum Dei Performance — automation stack environment
# Copy to the REPO ROOT as `.env` (docker compose reads it automatically):
#   cp automation/.env.example .env
# then fill in the values below. Never commit the real .env.

# ─── n8n security ─────────────────────────────────────────────────────────
# REQUIRED. Encrypts saved credentials. Generate once and never change it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ─── n8n public address ───────────────────────────────────────────────────
# For local testing the defaults are fine. For production set these to your
# real domain so webhooks and the Stripe Trigger register the correct URLs.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_WEBHOOK_BASE=http://localhost:5678
# Set false only when reaching n8n over plain http (local). Leave true behind https.
N8N_SECURE_COOKIE=false
TZ=America/New_York

# Production example (uncomment and edit once you have a domain + reverse proxy):
#N8N_HOST=n8n.donumdeiperformance.com
#N8N_PROTOCOL=https
#WEBHOOK_URL=https://n8n.donumdeiperformance.com/
#N8N_WEBHOOK_BASE=https://n8n.donumdeiperformance.com
#N8N_SECURE_COOKIE=true

# ─── App wiring used by the workflows ─────────────────────────────────────
# Same-box default: n8n reaches the API over the compose network as http://api:8000.
DONUM_DEI_API_URL=http://api:8000
DDP_WEB_URL=http://localhost:3000
DDP_EMAIL_FROM=Donum Dei Performance <programs@donumdeiperformance.com>
DDP_OWNER_EMAIL=johnrizkalla2300@gmail.com
DDP_CLAUDE_MODEL=claude-sonnet-5

# ─── API provider keys (only if you run the API with real generation) ─────
# The API defaults to LLM_PROVIDER=mock and needs no key. For real programs:
#LLM_PROVIDER=claude
#ANTHROPIC_API_KEY=sk-ant-...

# NOTE: The service API keys the WORKFLOWS use (Notion, Anthropic, Resend,
# Stripe) are NOT set here. They are entered once inside the n8n UI as
# Credentials — see automation/SETUP.md step 5. n8n stores them encrypted.
