      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, -200],
      "credentials": { "notionApi": { "id": "REPLACE_ME_NOTION", "name": "Notion API" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $env.DDP_EMAIL_FROM || 'Donum Dei Performance <programs@donumdeiperformance.com>', to: [$json.email], subject: 'A payment needs your attention — Donum Dei Performance', text: 'A scheduled payment for your membership did not go through.\\n\\nNo access has been interrupted yet. Update your card here and the matter closes itself:\\n' + ($env.DDP_WEB_URL || 'https://donumdeiperformance.com') + '/dashboard\\n\\nIf something has changed and you would rather pause or step away, reply to this email — it reaches the practice directly.\\n\\nDonum Dei. The body is a gift. Train it accordingly.' }) }}",
        "options": {}
