        "jsCode": "const ev = $('Normalize Event').first().json;\nconst page = ($input.first().json.results || [])[0];\nif (!page) { return [{ json: { ...ev, clientPageId: null, email: null } }]; }\nreturn [{ json: { ...ev, clientPageId: page.id, email: page.properties?.Email?.email || null } }];"
      },
