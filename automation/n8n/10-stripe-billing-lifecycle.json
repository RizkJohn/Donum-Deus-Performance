        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: Object.assign({ 'Status': { select: { name: 'Active' } }, 'Stripe Customer ID': { rich_text: [{ text: { content: String($json.customerId || '') } }] } }, $json.tier ? { 'Tier': { select: { name: $json.tier } } } : {}) }) }}",
        "options": {}
      },
