{
  "name": "DDP — 10 Stripe Billing Lifecycle → Clients",
  "nodes": [
    {
      "parameters": {
        "events": ["checkout.session.completed", "invoice.payment_failed", "customer.subscription.deleted"]
      },
      "id": "n1-trigger",
      "name": "Stripe Events",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "webhookId": "ddp-stripe",
      "credentials": { "stripeApi": { "id": "REPLACE_ME_STRIPE", "name": "Stripe API" } }
    },
    {
      "parameters": {
        "jsCode": "// Native Stripe Trigger already verified the signature. Normalize to a common shape.\nconst ev = $json;\nconst t = ev.type;\nconst o = (ev.data && ev.data.object) || {};\nlet route = 'ignore', email = null, customerId = o.customer || null, subscriptionId = null, tier = null, amount = null;\nif (t === 'checkout.session.completed') {\n  route = 'converted';\n  email = (o.customer_details && o.customer_details.email) || o.customer_email || null;\n  subscriptionId = o.subscription || null;\n  tier = (o.metadata && o.metadata.tier) || null;\n  amount = typeof o.amount_total === 'number' ? o.amount_total / 100 : null;\n} else if (t === 'invoice.payment_failed') {\n  route = 'payment_failed';\n  email = o.customer_email || null;\n} else if (t === 'customer.subscription.deleted') {\n  route = 'churned';\n  tier = (o.metadata && o.metadata.tier) || null;\n}\nconst tierName = tier ? (tier.charAt(0).toUpperCase() + tier.slice(1)) : null;\nreturn [{ json: { route, email, customerId, subscriptionId, tier: tierName, amount, rawType: t } }];"
      },
      "id": "n2-normalize",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.route }}", "rightValue": "converted", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "converted" },
            { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.route }}", "rightValue": "payment_failed", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "payment_failed" },
            { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.route }}", "rightValue": "churned", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "renameOutput": true, "outputKey": "churned" }
          ]
        },
        "options": {}
      },
      "id": "n3-route",
      "name": "Route by Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/8880de55-6bcb-4b72-a9a1-3932a1f774f8/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Notion-Version", "value": "2022-06-28" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { property: 'Email', email: { equals: $json.email } }, page_size: 1 }) }}",
        "options": {}
      },
      "id": "n4-findclient",
      "name": "Find Client by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -200],
      "credentials": { "notionApi": { "id": "REPLACE_ME_NOTION", "name": "Notion API" } }
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Normalize Event').first().json;\nconst res = $input.first().json;\nconst page = (res.results || [])[0];\nreturn [{ json: { ...ev, clientPageId: page ? page.id : null, today: new Date().toISOString().slice(0, 10) } }];"
      },
      "id": "n5-decide",
      "name": "Decide Create or Patch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [ { "leftValue": "={{ $json.clientPageId }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n6-exists",
      "name": "Client Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, -200]
    },
