{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerateRequest",
  "type": "object",
  "required": ["client_profile", "goals", "schedule", "state"],
  "additionalProperties": false,
  "properties": {
    "client_profile": {
      "type": "object",
      "required": ["age", "weight", "training_age"],
      "additionalProperties": false,
      "properties": {
        "age":         {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 120},
        "sex":         {"type": "string", "enum": ["male","female","other"]},
        "weight":      {"type": "number", "exclusiveMinimum": 0},
        "height_cm":   {"type": "number", "exclusiveMinimum": 0},
        "training_age":{"type": "string", "enum": ["Beginner","Intermediate","Advanced","Elite"]},
        "lifestyle":   {"type": "string", "enum": ["sedentary","lightly_active","active","very_active"]}
      }
    },
    "goals": {
      "type": "object",
      "required": ["primary", "secondary"],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string",
          "enum": ["strength","hypertrophy","fat_loss","athletic_performance","general_fitness","endurance","mobility","rehabilitation"]
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["strength","hypertrophy","fat_loss","athletic_performance","general_fitness","endurance","mobility","rehabilitation"]
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["available_days", "sport_days", "session_duration"],
      "additionalProperties": false,
      "properties": {
        "available_days": {
          "type": "array",
          "items": {"type": "string", "enum": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]}
        },
        "sport_days": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "enum": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]}
          }
        },
        "session_duration": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "state": {
      "type": "object",
      "required": ["sleep", "soreness", "energy", "stress", "injuries"],
      "additionalProperties": false,
      "properties": {
        "sleep":    {"type": "number", "minimum": 1, "maximum": 5},
        "soreness": {"type": "number", "minimum": 1, "maximum": 5},
        "energy":   {"type": "number", "minimum": 1, "maximum": 5},
        "stress":   {"type": "number", "minimum": 1, "maximum": 5},
        "injuries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["barbell","dumbbells","cables","machines","kettlebells","resistance_bands","pull_up_bar","sled","med_ball","bodyweight_only"]
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consecutive_training_weeks": {"type": "integer", "minimum": 0},
        "last_deload_week": {"type": ["string","null"]}
      }
    }
  }
}
